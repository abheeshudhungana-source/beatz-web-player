# Spotify Developer Application Credentials
# Obtain these from: https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# OAuth Callback URL
# Ensure this exact redirect URI is registered in your Spotify Developer App Settings:
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/callback/spotify

# NextAuth / App Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# AI Chatbot Engine (Gemini API)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

